ORACLE_INSTANCE_ID=1
# Optional override used to select a non-default env file.
ORACLE_ENV_FILE=
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
ORACLE_PRIVATE_KEY=
ORACLE_API_KEY=
BACKEND_API_URL=http://localhost:5000
MOCK_HOSPITAL_API_URL=http://localhost:5000/mock/hospital/verify
ORACLE_START_BLOCK=0
ORACLE_POLL_INTERVAL_MS=5000
ORACLE_HEARTBEAT_INTERVAL_MS=30000
ORACLE_EVENT_QUERY_CHUNK_SIZE=2000
ORACLE_SUBMIT_MAX_ATTEMPTS=3
ORACLE_SUBMIT_RETRY_DELAY_MS=5000
# Defaults to oracle/.oracle-state/cursor-<instance>.json. Use disabled only for disposable runs.
ORACLE_CURSOR_FILE=
ORACLE_REGISTRY_SNAPSHOT=primary
# Optional absolute path; defaults to ../backEnd/model-params.json.
MODEL_ARTIFACT_PATH=
# Used only when this file is adapted for Oracle 2.
ORACLE_PRIVATE_KEY_2=
ORACLE2_SIMULATED_NETWORK_DELAY_MS=3000
