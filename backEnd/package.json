    "grant:roles": "node scripts/grantProjectRolesLocal.js",
    "oracle:local": "node scripts/submitOracleResultLocal.js",
    "fund:local": "node scripts/fundContractLocal.js",
    "reset:local": "node scripts/resetLocalData.js --yes",
    "reset:hybrid": "node scripts/resetLocalData.js --yes --hybrid",
    "verify:clean": "node scripts/verifyCleanStart.js",
    "seed:mock": "node scripts/seedMockData.js",
    "build:hybrid": "node scripts/buildHybridDataset.js",
    "validate:hybrid": "node scripts/validateHybridDataset.js",
    "seed:hybrid": "node scripts/seedHybridData.js",
    "demo:populate": "node scripts/populateDemoScenario.js",
    "verify:demo": "node scripts/verifyDemoSeed.js",
    "demo:check": "node scripts/demoCheck.js",
    "train:model": "node scripts/trainModel.js",
    "freeze:model": "node scripts/freezeModelArtifact.js",
    "freeze:triage": "node scripts/freezeTriagePolicy.js",
    "generate:datasets": "node scripts/generateSyntheticDatasets.js",
    "evaluate:phase5": "node scripts/evaluatePhase5.js",
    "evaluate:reserve": "node scripts/evaluateReserveAdequacy.js",
    "evaluate:evidence": "node scripts/evaluateEvidenceLifecycle.js",
    "charts:phase34": "node scripts/generatePhase34Charts.js",
    "charts:manifest": "node scripts/generateChartManifest.js",
    "research:phase34": "npm run evaluate:reserve && npm run evaluate:evidence && npm run charts:phase34 && npm run charts:manifest && npm run research:manifest",
    "research:manifest": "node scripts/generateResearchManifest.js",
    "research:baseline": "npm run generate:datasets && npm run freeze:model && npm run freeze:triage && npm run evaluate:phase5 && npm run charts:generate && npm run charts:manifest && npm run research:manifest",
    "research:artifacts": "npm run generate:datasets && npm run freeze:model && npm run freeze:triage && npm run evaluate:phase5 && npm run evaluate:reserve && npm run evaluate:evidence && npm run charts:generate && npm run charts:phase34 && npm run charts:manifest && npm run research:manifest",
    "metrics:collect": "node scripts/collectResearchMetrics.js",
    "push:merkle": "node scripts/pushMerkleRoot.js",
    "backfill:evidence-chain": "node scripts/backfillEvidenceChains.js",
    "evaluate:risk": "node scripts/evaluatePhase5.js",
    "evaluate:risk:synthetic": "node scripts/evaluatePhase5.js",
    "charts:generate": "node scripts/generateEvaluationCharts.js",
    "analyze:auditors": "node scripts/analyzeAuditorReputation.js",
    "loadtest:claims": "node scripts/loadTestClaims.js",
    "test:section3": "node scripts/testSection3Analytics.js",
    "test:unit": "node --test test/*.test.js",
    "role:set": "node scripts/setUserRole.js"
  },
  "keywords": [],
