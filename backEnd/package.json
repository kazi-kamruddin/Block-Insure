{
  "name": "backend",
  "version": "1.0.0",
  "description": "Block-Insure API, oracle registry, and thesis evaluation tools",
  "main": "server.js",
  "scripts": {
    "test": "npm run test:section3 && npm run test:unit",
    "dev": "nodemon server.js",
