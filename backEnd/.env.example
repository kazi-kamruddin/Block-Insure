MONGODB_URI=
PORT=
FORCE_PUBLIC_DNS=
NODE_ENV=development
# Keep false in production so internal exception details remain hidden.
EXPOSE_INTERNAL_ERRORS=false
JWT_SECRET=
JWT_ISSUER=block-insure-api
JWT_AUDIENCE=block-insure-client
JWT_EXPIRES_IN=7d
AUTH_NONCE_TTL_MS=300000
AUTH_NONCE_RATE_WINDOW_MS=900000
AUTH_NONCE_RATE_LIMIT=30
AUTH_LOGIN_RATE_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT=15
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PINATA_API_KEY=
PINATA_SECRET=
PINATA_JWT=
VITE_CONTRACT_ADDRESS=
POLICY_BENEFITS_ADDRESS=
POLICY_BENEFITS_DEPLOYMENT_BLOCK=0
CONTRACT_DEPLOYMENT_BLOCK=0
RPC_URL=
ADMIN_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=
ORACLE_PRIVATE_KEY_2=
ORACLE_API_KEY=
CLAIM_OFFICER_WALLET_ADDRESS=
AUDITOR_WALLET_ADDRESS=
AUDITOR_WALLET_ADDRESS_2=
AUDITOR_WALLET_ADDRESS_3=
AUDITOR_WALLET_ADDRESS_4=
DEMO_USE_HARDHAT_ACCOUNTS=true
DEMO_PACKAGE_ID=1
DEMO_USER_PRIVATE_KEY=
DEMO_AUDITOR_PRIVATE_KEY=
DEMO_AUDITOR_PRIVATE_KEY_2=
# Optional inputs for verify:demo endpoint checks.
BACKEND_URL=http://localhost:5000
DEMO_ADMIN_JWT=
ORACLE_WORKER_PORT=
ORACLE2_WORKER_PORT=
CLAIM_SUBMISSION_RATE_WINDOW_MS=900000
CLAIM_SUBMISSION_RATE_LIMIT=5
CLAIMS_PER_WALLET_24H=3
# Local testing only. Never enable this in production.
DEV_ALLOW_CLAIM_LIMIT_RESET=false
MINIMUM_AUDITOR_VOTES=2
EVIDENCE_KEY_DIRECTORY=
EVIDENCE_RSA_PRIVATE_KEY_PEM=
EVIDENCE_RSA_PUBLIC_KEY_PEM=
EVIDENCE_RSA_KEY_PASSPHRASE=
# JSON object keyed by historical keyId; retain old private keys during rotation.
EVIDENCE_RSA_PREVIOUS_KEYS_JSON={}
LOAD_TEST_BACKEND_URL=http://localhost:5000/health
LOAD_TEST_PACKAGE_ID=1
LOAD_TEST_CLAIM_AMOUNT_ETH=0.01
LOAD_TEST_CONCURRENCY_LEVELS=1,5,10,20,50
