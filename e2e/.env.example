# Block-Insure browser E2E configuration.
# Copy this file to e2e/.env. The real file is ignored by Git.
# Use LOCAL-HARDHAT-ONLY wallets. Never use keys controlling real assets.

# Admin and both Oracle keys are read from backEnd/.env, their authoritative
# service configuration. They are validated here but must not be duplicated.

# These four keys must derive, in order, to the four public addresses in:
# backEnd/.env -> AUDITOR_WALLET_ADDRESS through AUDITOR_WALLET_ADDRESS_4.
# MetaMask exports may omit the 0x prefix; both forms are accepted.
E2E_AUDITOR_PRIVATE_KEY_1=
E2E_AUDITOR_PRIVATE_KEY_2=
E2E_AUDITOR_PRIVATE_KEY_3=
E2E_AUDITOR_PRIVATE_KEY_4=

# Browser role: normal User. When empty, the suite uses Hardhat's built-in
# local account #1; set this only to test a different local-only User wallet.
E2E_USER_PRIVATE_KEY=

# The five application services are expected to be started manually.
E2E_APP_URL=http://localhost:5173
E2E_API_URL=http://localhost:5000
E2E_RPC_URL=http://127.0.0.1:8545
E2E_CHAIN_ID=31337

# "real" exercises the backend's configured Pinata account.
# No Google/Pinata website login is involved.
E2E_PINATA_MODE=real

# The normal test command is read-only. The separate workflow command purchases
# a local policy and uploads one uniquely generated encrypted evidence image.

# Keep headed mode off here; use npm run test:e2e:headed when desired.
E2E_ACTION_TIMEOUT_MS=15000
E2E_SCENARIO_TIMEOUT_MS=120000
