{
  "name": "contracts",
  "version": "1.0.0",
  "description": "Block-Insure smart contracts and Hardhat verification suite",
  "private": true,
  "scripts": {
    "node": "node scripts/runHardhat.js node",
    "test": "node scripts/runHardhat.js test",
    "coverage": "node scripts/runCoverage.js",
    "compile": "node scripts/runHardhat.js compile",
    "sync:abi": "node scripts/sync-abi.js",
    "deploy:local": "node scripts/runHardhat.js run scripts/deploy.js --network localhost",
    "deploy:sepolia": "node scripts/runHardhat.js run scripts/deploy.js --network sepolia",
    "deploy:benefits:local": "node scripts/runHardhat.js run scripts/deploy-benefits-local.js --network localhost",
    "fund:accounts:local": "node scripts/runHardhat.js run scripts/fund-demo-accounts-local.js --network localhost",
    "gas:compare": "node scripts/runHardhat.js run scripts/gasComparison.js",
    "test:stateful": "node scripts/runHardhat.js test test/Phase5StatefulInvariants.test.js test/Phase6ProtocolStatefulInvariants.test.js",
