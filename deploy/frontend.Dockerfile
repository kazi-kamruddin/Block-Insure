FROM node:22-alpine AS build

WORKDIR /app
COPY frontEnd/package.json frontEnd/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontEnd ./

ARG VITE_API_BASE_URL
ARG VITE_CONTRACT_ADDRESS
ARG VITE_CLAIM_ADJUDICATOR_ADDRESS
ARG VITE_POLICY_ECONOMICS_ADDRESS
ARG VITE_EVIDENCE_REGISTRY_ADDRESS
ARG VITE_HOSPITAL_VERIFICATION_REGISTRY_ADDRESS
ARG VITE_BANK_IDENTITY_REGISTRY_ADDRESS
ARG VITE_PROTOCOL_DEPLOYMENT_REGISTRY_ADDRESS
ARG VITE_POLICY_BENEFITS_ADDRESS
ARG VITE_POLICY_BENEFITS_DEPLOYMENT_BLOCK
ARG VITE_CONTRACT_DEPLOYMENT_BLOCK
ARG VITE_RPC_URL
ARG VITE_CHAIN_ID
ARG VITE_NETWORK_NAME
ARG VITE_BLOCK_EXPLORER_URL
ARG VITE_IPFS_GATEWAY

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_CONTRACT_ADDRESS=$VITE_CONTRACT_ADDRESS \
    VITE_CLAIM_ADJUDICATOR_ADDRESS=$VITE_CLAIM_ADJUDICATOR_ADDRESS \
    VITE_POLICY_ECONOMICS_ADDRESS=$VITE_POLICY_ECONOMICS_ADDRESS \
    VITE_EVIDENCE_REGISTRY_ADDRESS=$VITE_EVIDENCE_REGISTRY_ADDRESS \
    VITE_HOSPITAL_VERIFICATION_REGISTRY_ADDRESS=$VITE_HOSPITAL_VERIFICATION_REGISTRY_ADDRESS \
    VITE_BANK_IDENTITY_REGISTRY_ADDRESS=$VITE_BANK_IDENTITY_REGISTRY_ADDRESS \
    VITE_PROTOCOL_DEPLOYMENT_REGISTRY_ADDRESS=$VITE_PROTOCOL_DEPLOYMENT_REGISTRY_ADDRESS \
    VITE_POLICY_BENEFITS_ADDRESS=$VITE_POLICY_BENEFITS_ADDRESS \
    VITE_POLICY_BENEFITS_DEPLOYMENT_BLOCK=$VITE_POLICY_BENEFITS_DEPLOYMENT_BLOCK \
    VITE_CONTRACT_DEPLOYMENT_BLOCK=$VITE_CONTRACT_DEPLOYMENT_BLOCK \
    VITE_RPC_URL=$VITE_RPC_URL \
    VITE_CHAIN_ID=$VITE_CHAIN_ID \
    VITE_NETWORK_NAME=$VITE_NETWORK_NAME \
    VITE_BLOCK_EXPLORER_URL=$VITE_BLOCK_EXPLORER_URL \
    VITE_IPFS_GATEWAY=$VITE_IPFS_GATEWAY

RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
